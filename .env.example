APP_NAME=CampusReserve
APP_ENV=development
LOG_LEVEL=INFO
POSTGRES_DB=campus_reserve
POSTGRES_USER=campus
POSTGRES_PASSWORD=campus_dev_password
POSTGRES_DSN=postgresql+asyncpg://campus:campus_dev_password@postgres:5432/campus_reserve
REDIS_URL=redis://redis:6379/0
BOOKING_STREAM=campus-reserve:{booking}:reservation-events
BOOKING_DEAD_LETTER_STREAM=campus-reserve:{booking}:reservation-events:dead-letter
BOOKING_CONSUMER_GROUP=booking-workers
BOOKING_CLAIM_IDLE_MS=30000
BOOKING_RESULT_TTL_SECONDS=604800
JWT_SECRET=replace-this-in-a-real-environment
JWT_ALGORITHM=HS256
JWT_ISSUER=campus-reserve
JWT_ACCESS_TOKEN_MINUTES=30
